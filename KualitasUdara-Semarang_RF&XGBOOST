        "import numpy as np\n",
        "\n",
        "def calculate_ispu(x, bp_conc, bp_ispu):\n",
        "    \"\"\"\n",
        "    Calculate ISPU using linear interpolation.\n",
        "    x: actual concentration\n",
        "    bp_conc: list of concentration breakpoints [B_low, ..., B_high]\n",
        "    bp_ispu: list of ISPU index breakpoints [I_low, ..., I_high]\n",
        "    \"\"\"\n",
        "    if x <= bp_conc[0]:\n",
        "        return (bp_ispu[0] / bp_conc[0]) * x if bp_conc[0] != 0 else 0\n",
        "\n",
        "    for i in range(1, len(bp_conc)):\n",
        "        if x <= bp_conc[i]:\n",
        "            Bb = bp_conc[i-1]\n",
        "            Ba = bp_conc[i]\n",
        "            Ib = bp_ispu[i-1]\n",
        "            Ia = bp_ispu[i]\n",
        "            return ((Ia - Ib) / (Ba - Bb)) * (x - Bb) + Ib\n",
        "\n",
        "    # If x exceeds the highest breakpoint, extrapolate or cap (usually capped or higher slope)\n",
        "    return bp_ispu[-1]\n",
        "\n",
        "# Define Breakpoints based on PERMEN LHK No. 14 Tahun 2020\n",
        "ispu_indices = [0, 50, 100, 200, 300, 500]\n",
        "breakpoints = {\n",
        "    'CO': [0, 4000, 8000, 15000, 30000, 45000],\n",
        "}\n",
        "\n",
        "# Calculate individual ISPU for each pollutant\n",
        "pollutants = [ 'CO']\n",
        "for p in pollutants:\n",
        "    df_procc[f'ISPU_{p}'] = df_procc[p].apply(lambda val: calculate_ispu(val, breakpoints[p], ispu_indices))\n",
        "\n",
        "# Overall ISPU is the maximum value among all pollutants\n",
        "df_procc['ISPU_Score'] = df_procc[[f'ISPU_{p}' for p in pollutants]].max(axis=1)\n",
        "\n",
        "# Categorize based on ISPU Score\n",
        "def get_category(score):\n",
        "    if score <= 50:\n",
        "        return 'Baik'\n",
        "    elif score <= 100:\n",
        "        return 'Sedang'\n",
        "    elif score <= 200:\n",
        "        return 'Tidak Sehat'\n",
        "    elif score <= 300:\n",
        "        return 'Sangat Tidak Sehat'\n",
        "    else:\n",
        "        return 'Berbahaya'\n",
        "\n",
        "df_procc['Kategori'] = df_procc['ISPU_Score'].apply(get_category)\n",
        "\n",
        "# Display the results\n",
        "print(\"Distribusi Kategori ISPU:\")\n",
        "print(df_procc['Kategori'].value_counts())\n",
        "print(\"\\nContoh data dengan Label ISPU:\")\n",
        "df_procc[['CO', 'ISPU_Score', 'Kategori']].head()"
